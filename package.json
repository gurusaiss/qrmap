{
  "name": "qrmap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx src/modules/db/migrate.ts",
    "db:seed": "tsx src/modules/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:isolation": "vitest run src/modules/tenancy/__tests__",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "worker": "tsx src/modules/db/worker.ts"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "jsqr": "^1.4.0",
    "mammoth": "^1.13.0",
    "next": "16.4.2",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.18.8",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jszip": "^3.10.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.4"
  }
}
