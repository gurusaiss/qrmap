# --- Database -------------------------------------------------------------
# Owner role: runs migrations, owns tables. NEVER used by the application.
DATABASE_URL_OWNER=postgres://mdp_owner:ownerpass@localhost:5432/mdp_dev
# App role: NOSUPERUSER, NOBYPASSRLS, tenant-restricted by RLS. Public page and
# merchant dashboard queries use this.
DATABASE_URL=postgres://mdp_app:apppass@localhost:5432/mdp_dev
# System role: NOSUPERUSER, NOBYPASSRLS, but not tenant-restricted. Auth, slug
# resolution, platform admin and background jobs use this.
# REQUIRED IN PRODUCTION: if unset, auth silently falls back to DATABASE_URL,
# which has NO grants on users/sessions/otp_codes, and auth will fail entirely.
DATABASE_URL_SYSTEM=postgres://mdp_system:systempass@localhost:5432/mdp_dev

# --- Application ----------------------------------------------------------
APP_URL=http://localhost:3000
# Public origin printed into QR codes. Changing this invalidates printed QRs.
PUBLIC_QR_ORIGIN=http://localhost:3000
SESSION_SECRET=dev-only-change-me-to-32-bytes-minimum-secret
ANALYTICS_SALT_SECRET=dev-only-change-me-analytics-salt-secret

# --- Storage --------------------------------------------------------------
# driver: local (dev) | r2 (production)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads-dev
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- AI -------------------------------------------------------------------
# provider: none | mock | groq | cloudflare | gemini
#
# GROQ is the recommended default: genuinely free tier, no card required, and
# the fastest inference of the three. Get a key at https://console.groq.com
#
# Fallback behaviour (src/modules/ai/provider.ts): if the configured provider
# fails or its free tier hits its daily cap, the next provider WITH
# CREDENTIALS CONFIGURED is tried automatically. If none succeed, the
# assistant falls back to deterministic answers (opening hours, location,
# prices, current offers) which need no API key at all - so a missing or
# exhausted key narrows the answers, it never breaks the page.
#
# Leave AI_PROVIDER=none to run deterministic-only with zero external calls.
AI_PROVIDER=groq
AI_API_KEY=
# Optional per-provider model override; sensible defaults are built in.
AI_MODEL=
# Only needed if you add cloudflare as a fallback.
CLOUDFLARE_ACCOUNT_ID=

# --- SMS (OTP) ------------------------------------------------------------
# driver: console (dev, logs the OTP) | msg91
SMS_DRIVER=console
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
